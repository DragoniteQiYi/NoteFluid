<Window x:Class="NoteFluid.Core.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NoteFluid.Core.Controls" 
        xmlns:local="clr-namespace:NoteFluid.Core"
        xmlns:views="clr-namespace:NoteFluid.Core.Views"
        xmlns:viewModels="clr-namespace:NoteFluid.Core.ViewModels"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="NoteFluid" Height="800" Width="1200"
        WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme 
                    BaseTheme="Light" 
                    PrimaryColor="Purple" 
                    SecondaryColor="Amber" />
                <materialDesign:BundledTheme 
                    BaseTheme="Dark" 
                    PrimaryColor="DeepOrange" 
                    SecondaryColor="Amber" />
                
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <!-- 页面容器 -->
        <Frame x:Name="MainFrame" Grid.Row="1" 
               NavigationUIVisibility="Hidden" />
    </Grid>
</Window>