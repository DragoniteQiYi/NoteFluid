<Page x:Class="NoteFluid.Core.Views.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoteFluid.Core.Views"
      xmlns:views="clr-namespace:NoteFluid.Core.Views"
      xmlns:vm="clr-namespace:NoteFluid.Core.ViewModels"
      xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Settings">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 为深色模式切换时使用的资源 -->
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A0533" Opacity="0.7"/>
            <SolidColorBrush x:Key="TextForegroundBrush" Color="White"/>

            <!-- 卡片样式 -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8" 
                            ShadowDepth="2" 
                            Opacity="0.1"
                            Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!-- ==================== 动态背景层 ==================== -->
        <Canvas x:Name="BackgroundCanvas" ClipToBounds="True">

            <!-- 3. 网格线装饰 -->
            <Path Stroke="#ffffff" StrokeThickness="0.5" Opacity="0.05">
                <Path.Data>
                    <GeometryGroup>
                        <!-- 水平线 -->
                        <LineGeometry StartPoint="0,50" EndPoint="800,50"/>
                        <LineGeometry StartPoint="0,100" EndPoint="800,100"/>
                        <LineGeometry StartPoint="0,200" EndPoint="800,200"/>
                        <LineGeometry StartPoint="0,300" EndPoint="800,300"/>
                        <LineGeometry StartPoint="0,400" EndPoint="800,400"/>
                        <!-- 竖直线 -->
                        <LineGeometry StartPoint="100,0" EndPoint="100,450"/>
                        <LineGeometry StartPoint="200,0" EndPoint="200,450"/>
                        <LineGeometry StartPoint="400,0" EndPoint="400,450"/>
                        <LineGeometry StartPoint="600,0" EndPoint="600,450"/>
                        <LineGeometry StartPoint="700,0" EndPoint="700,450"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <!-- 4. 对角线装饰 -->
            <Path Stroke="#7c3aed" StrokeThickness="1" Opacity="0.08">
                <Path.Data>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="400,450"/>
                        <LineGeometry StartPoint="400,0" EndPoint="800,450"/>
                        <LineGeometry StartPoint="0,200" EndPoint="800,0"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </Canvas>

        <materialDesign:DialogHost x:Name="RootDialogHost">
            <materialDesign:DialogHost.DialogContent>
                <materialDesign:Card Width="320" Padding="0" Background="Transparent">
                    <StackPanel>
                        <!-- 标题栏 -->
                        <Border Background="{DynamicResource MaterialDesignPaper}" 
                        Padding="20">
                            <TextBlock Text="选择主题颜色" 
                              FontSize="18" 
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Border>

                        <!-- 颜色列表 - 点击即选择并关闭 -->
                        <ListBox x:Name="ColorListBox"
                                 ItemsSource="{Binding Colors}"
                                 SelectedItem="{Binding SelectedColor}"
                                 BorderThickness="0"
                                 SelectionChanged="ColorListBox_SelectionChanged"
                                 MaxHeight="300">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,10" CornerRadius="4" Margin="4,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 圆形颜色预览 -->
                                            <Ellipse Grid.Column="0"
                                            Width="36" 
                                            Height="36" 
                                            Fill="{Binding ColorBrush}"
                                            Margin="0,0,16,0"/>

                                            <!-- 颜色名称 -->
                                            <TextBlock Grid.Column="1"
                                              Text="{Binding Name}" 
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 底部取消按钮 -->
                        <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           Margin="16">
                            <Button Content="关闭" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </materialDesign:DialogHost.DialogContent>

            <Grid Background="{DynamicResource MaterialDesignPaper}">
                <Grid.RowDefinitions>
                    <!-- 标题区域：固定高度 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 功能区：自动填充剩余空间，并垂直居中 -->
                    <RowDefinition Height="*"/>
                    <!-- 版本信息：固定高度 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. 标题区域 -->
                <Border Grid.Row="0" 
            Background="{DynamicResource MaterialDesign.Brush.Primary}"
            Padding="20,25" BorderThickness="0,0,0,1" 
            BorderBrush="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
       Text="NoteFluid MIDI音乐播放器"
       FontSize="32"
       FontWeight="Bold"
       Foreground="{DynamicResource MaterialDesignBody}"
       VerticalAlignment="Center"/>

                        <!-- 装饰性音乐图标 -->
                        <materialDesign:PackIcon Grid.Column="1" 
                     Kind="MusicNote" 
                     Width="40" 
                     Height="40" 
                     Foreground="{DynamicResource MaterialDesignBody}"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <!-- 居中面板容器 -->
                    <StackPanel 
VerticalAlignment="Center" 
HorizontalAlignment="Center"
Width="500">

                        <!-- 标题 -->
                        <TextBlock Text="设置" 
                           FontSize="36" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30">

                        </TextBlock>
                        <!-- 1. 声音输出设备选择 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="音频输出设备" 
                FontSize="16" 
                FontWeight="SemiBold"
                Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock 
                Text="选择应用播放音频的输出设备" 
                FontSize="12"
                Foreground="{DynamicResource MaterialDesignBody}"
                Margin="0,2,0,0"/>
                                </StackPanel>

                                <ComboBox 
            x:Name="AudioDeviceComboBox"
            Grid.Column="1"
            Style="{StaticResource MaterialDesignOutlinedComboBox}"
            VerticalAlignment="Center"
            materialDesign:HintAssist.Hint="选择设备"
            materialDesign:TextFieldAssist.SuffixText=""
            SelectionChanged="AudioDeviceComboBox_SelectionChanged"
            ItemsSource="{Binding OutputDevices}"
            SelectedItem="{Binding SelectedDevice}"
            >
                                    <!-- 添加 ItemContainerStyle 设置下拉项样式 -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 2. 测试声音按钮 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock 
                Text="测试声音" 
                FontSize="16" 
                FontWeight="SemiBold"
                Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock 
                Text="播放Windows提示音" 
                FontSize="12"
                Foreground="{DynamicResource MaterialDesignBody}"
                Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button 
            x:Name="TestSoundButton"
            Grid.Column="1"

            Style="{StaticResource MaterialDesignOutlinedButton}"
            VerticalAlignment="Center"
            Click="TestSoundButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon 
                        Kind="VolumeHigh" 
                        Width="20" 
                        Height="20" 
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                                            <TextBlock Text="播放" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 3. 黑夜模式切换 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock 
                                Text="切换黑夜模式" 
                                FontSize="16" 
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock 
                                Text="在浅色和深色主题之间切换" 
                                FontSize="12"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton 
                            x:Name="DarkModeToggle"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            VerticalAlignment="Center"
                            Checked="DarkModeToggle_Checked"
                            Unchecked="DarkModeToggle_Unchecked">
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- 4. 主题颜色切换 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                        <TextBlock Text="主题颜色" 
                                      FontSize="16" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource MaterialDesignBody}"/>
                                    
                                    <TextBlock Text="修改应用主题颜色" 
                                  FontSize="12"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 点击打开对话框的按钮 -->
                                <Button x:Name="ColorPickerButton"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            VerticalAlignment="Center"
                            Click="ColorPickerButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Palette" 
                                                        Width="20" 
                                                        Height="20" 
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"/>
                                            <TextBlock Text="选择颜色" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 5. 打开MIDI文件夹按钮 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock 
                Text="MIDI 文件夹" 
                FontSize="16" 
                FontWeight="SemiBold"
                Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock 
                Text="打开本地MIDI文件夹" 
                FontSize="12"
                Foreground="{DynamicResource MaterialDesignBody}"
                Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button 
            x:Name="OpenMidiFolderButton"
            Grid.Column="1"

            Style="{StaticResource MaterialDesignOutlinedButton}"
            VerticalAlignment="Center"
            Click="OpenMidiFolderButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon 
                        Kind="FolderOpen" 
                        Width="20" 
                        Height="20" 
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                                            <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 6. 返回菜单按钮 -->
                        <Border Background="#15FFFFFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="0"
                        Margin="0,20,0,0"
                        Width="200"
                        HorizontalAlignment="Center">
                            <Button x:Name="BackToMenuButton"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Height="45"
                            Click="BackToMenuButton_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon 
                                    Kind="ArrowLeft" 
                                    Width="20" 
                                    Height="20" 
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBlock Text="返回菜单" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Border>

                    </StackPanel>
                </Border>
                <!-- 3. 版本信息区域 -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource MaterialDesignPaper}"
                        Padding="20,15" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 版本信息 -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" 
                                                     Width="16" 
                                                     Height="16" 
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="版本 v0.2.1-alpha"
                                       FontSize="14"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 版权信息 -->
                        <TextBlock Grid.Column="1" 
                                   Text="© 2026 NoteFluid"
                                   FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   VerticalAlignment="Center"
                                   Opacity="0.7"/>
                    </Grid>
                </Border>

            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Page>
