<Page x:Class="NoteFluid.Core.Views.MidiVisualization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoteFluid.Core.Views"
      xmlns:views="clr-namespace:NoteFluid.Core.Views"
      xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="MidiVisualization">

    <Page.Resources>
        <!-- 白键样式 -->
        <Style x:Key="WhiteKeyStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,-1,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,0,3,3"
                                Margin="0,0,-1,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFE0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 黑键样式 -->
        <Style x:Key="BlackKeyStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="75"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,0,3,3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF404040"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部功能区 -->
            <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" 
                    Padding="15" 
                    Margin="0,0,0,0"
                    BorderThickness="0,0,0,0.5"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 最左侧：返回菜单按钮 -->
                    <!-- 最左侧：返回菜单按钮 -->
                    <Button Grid.Column="0" 
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        ToolTip="返回菜单"
                        HorizontalAlignment="Left"
                        Click="BackToFileListButton_Click">
                        <materialDesign:PackIcon Kind="ArrowLeft" 
                            Width="24" 
                            Height="24"/>
                    </Button>

                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}">
                <Slider x:Name="Progress" Minimum="0" Maximum="1"
                        VerticalAlignment="Center">
                    
                </Slider>
            </Border>
        </Grid>

        <!-- 钢琴键盘 - 底部区域 -->
        <Border Grid.Row="2" 
                Background="#FF2D2D2D"
                BorderBrush="Black"
                BorderThickness="1"
                Height="160">
            <Viewbox Stretch="Fill">
                <Canvas x:Name="PianoCanvas" 
                        Height="140" 
                        Width="1000">
                    <!-- 基准宽度，Viewbox会自动缩放 -->
                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</Page>
