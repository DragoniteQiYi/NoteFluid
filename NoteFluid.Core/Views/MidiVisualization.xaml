<Page x:Class="NoteFluid.Core.Views.MidiVisualization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoteFluid.Core.Views"
      xmlns:views="clr-namespace:NoteFluid.Core.Views"
      xmlns:converters="clr-namespace:NoteFluid.Core.Converters"
      xmlns:models="clr-namespace:NoteFluid.Core.Models"
      xmlns:vm="clr-namespace:NoteFluid.Core.ViewModels"
      xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=vm:VisualizationViewModel}"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="MidiVisualization">

    <Page.Resources>
        <!-- 转换器 -->
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"
                                         TrueBrush="#FFE0E0E0"
                                         FalseBrush="White"/>
        <converters:BoolToBrushConverter x:Key="BlackKeyBrushConverter"
                                         TrueBrush="#FF404040"
                                         FalseBrush="Black"/>
    </Page.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部功能区 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" 
                    Padding="15" 
                    Margin="0,0,0,0"
                    BorderThickness="0,0,0,0.5"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 返回菜单按钮 -->
                    <Button Grid.Column="0" 
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        ToolTip="返回菜单"
                        HorizontalAlignment="Left"
                        Click="BackToFileListButton_Click">
                        <materialDesign:PackIcon Kind="ArrowLeft" 
                            Width="24" 
                            Height="24"/>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}">
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1"
                             Height="20"
                             VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 钢琴键盘 - 底部区域（纯 Canvas，不使用 ItemsControl）-->
        <Border Grid.Row="2" 
                Background="#FF2D2D2D"
                BorderBrush="Black"
                BorderThickness="1"
                Height="160">
            <Viewbox Stretch="Fill">
                <Canvas x:Name="PianoCanvas" 
                        Height="140" 
                        Width="1000"
                        Background="Transparent">
                    <!-- 所有琴键由代码手动绘制 -->
                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</Page>
