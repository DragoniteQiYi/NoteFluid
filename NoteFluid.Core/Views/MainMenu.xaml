<Page x:Class="NoteFluid.Core.Views.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoteFluid.Core.Views"
      xmlns:views="clr-namespace:NoteFluid.Core.Views"
      xmlns:vm="clr-namespace:NoteFluid.Core.ViewModels"
      xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="MainMenu">

    <!-- 主容器：垂直排列的 Grid -->
    <Grid>
        <!-- ==================== 动态背景层 ==================== -->
        <Canvas x:Name="BackgroundCanvas" ClipToBounds="True">
            <!-- 1. 渐变背景 -->


            <!-- 3. 网格线装饰 -->
            <Path Stroke="#ffffff" StrokeThickness="0.5" Opacity="0.05">
                <Path.Data>
                    <GeometryGroup>
                        <!-- 水平线 -->
                        <LineGeometry StartPoint="0,50" EndPoint="800,50"/>
                        <LineGeometry StartPoint="0,100" EndPoint="800,100"/>
                        <LineGeometry StartPoint="0,200" EndPoint="800,200"/>
                        <LineGeometry StartPoint="0,300" EndPoint="800,300"/>
                        <LineGeometry StartPoint="0,400" EndPoint="800,400"/>
                        <!-- 竖直线 -->
                        <LineGeometry StartPoint="100,0" EndPoint="100,450"/>
                        <LineGeometry StartPoint="200,0" EndPoint="200,450"/>
                        <LineGeometry StartPoint="400,0" EndPoint="400,450"/>
                        <LineGeometry StartPoint="600,0" EndPoint="600,450"/>
                        <LineGeometry StartPoint="700,0" EndPoint="700,450"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <!-- 4. 对角线装饰 -->
            <Path Stroke="#7c3aed" StrokeThickness="1" Opacity="0.08">
                <Path.Data>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="400,450"/>
                        <LineGeometry StartPoint="400,0" EndPoint="800,450"/>
                        <LineGeometry StartPoint="0,200" EndPoint="800,0"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>

        </Canvas>
        <Grid>
            <Grid.RowDefinitions>
                <!-- 标题区域：固定高度 -->
                <RowDefinition Height="Auto"/>
                <!-- 功能区：自动填充剩余空间，并垂直居中 -->
                <RowDefinition Height="*"/>
                <!-- 版本信息：固定高度 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>



            <!-- 1. 标题区域 -->
            <Border Grid.Row="0" 
            Background="{DynamicResource MaterialDesign.Brush.Primary}"
            Padding="20,25" BorderThickness="0,0,0,1" 
                    BorderBrush="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                       Text="NoteFluid MIDI音乐播放器"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       VerticalAlignment="Center"/>

                    <!-- 装饰性音乐图标 -->
                    <materialDesign:PackIcon Grid.Column="1" 
                                     Kind="MusicNote" 
                                     Width="40" 
                                     Height="40" 
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- 2. 功能区（垂直居中） -->
            <Grid Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}">
                <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Width="350"
                    >

                    <!-- 功能区标题 -->
                    <TextBlock Text="欢迎使用"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

                    <!-- 演奏音乐按钮 -->
                    <Button Content="演奏音乐" Foreground="{DynamicResource MaterialDesignBody}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="50"
                    FontSize="18"
                    Margin="0,0,0,20"
                    Click="PlayButton_Click"
                    ToolTip="开始播放音乐">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayCircle" 
                                                     Width="24" 
                                                     Height="24" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding}" 
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- 设置按钮 -->
                    <Button Content="设置"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                    Height="50"
                    FontSize="18"
                    Margin="0,0,0,20"
                    Click="SettingsButton_Click"
                    ToolTip="打开设置菜单">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Settings" 
                                                     Width="24" 
                                                     Height="24" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding}" 
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- 退出按钮 -->
                    <Button Content="退出"
                    Style="{StaticResource MaterialDesignFlatDarkButton}"
                    Height="50"
                    FontSize="18"
                    Margin="0,10,0,0"
                    ToolTip="关闭应用程序"
                    Click="ExitButton_Click"
                    Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ExitToApp" 
                                                     Width="24" 
                                                     Height="24" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding}" 
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- 3. 版本信息区域 -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource MaterialDesignPaper}"
                    Padding="20,15" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 版本信息 -->
                    <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                         Width="16" 
                                         Height="16" 
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                        <TextBlock Text="版本 v0.1.0-alpha"
                           FontSize="14"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 版权信息 -->
                    <TextBlock Grid.Column="1" 
                       Text="© 2026 NoteFluid"
                       FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       VerticalAlignment="Center"
                       Opacity="0.7"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
