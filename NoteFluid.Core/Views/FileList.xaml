<Page x:Class="NoteFluid.Core.Views.FileList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoteFluid.Core.Views"
      xmlns:views="clr-namespace:NoteFluid.Core.Views"
      xmlns:vm="clr-namespace:NoteFluid.Core.ViewModels"
      xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:FileViewModel}"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="FileList">


    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <!-- 第一行：播放控制栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 第二行：搜索栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 第三行：文件列表滚动视图，占据剩余空间 -->
                <RowDefinition Height="*"/>
                <!-- 第四行：文件计数状态栏 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== 第一行：播放控制栏 ==================== -->
            <Border Grid.Row="0" 
                    Padding="15" 
                    Margin="0,0,0,0"
                    BorderThickness="0,0,0,0.5"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 最左侧：返回菜单按钮 -->
                    <Button Grid.Column="0" 
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        ToolTip="返回菜单"
                        HorizontalAlignment="Left"
                        Click="BackToMenuButton_Click">
                        <materialDesign:PackIcon Kind="ArrowLeft" 
                                     Width="24" 
                                     Height="24"/>
                    </Button>

                    <!-- 居中区域：包含播放按钮、进度条和文件名 -->
                    <StackPanel Grid.Column="1" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!-- 播放按钮 -->
                        <Button Style="{StaticResource MaterialDesignFloatingActionButton}"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                ToolTip="播放"
                                Width="32" 
                                Height="32"
                                Margin="0,0,0,8"
                                Command="{Binding PlayStopCommand}"
                                IsEnabled="{Binding CanPlay}"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsLoading}"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                                materialDesign:ButtonProgressAssist.Value="-1"
                                materialDesign:ButtonProgressAssist.IndicatorForeground="{DynamicResource MaterialDesign.Brush.Primary.Light}">
                            <materialDesign:PackIcon Kind="{Binding PlayIconKind}" 
                                         Width="24" 
                                         Height="24"/>
                        </Button>

                        <!-- 播放进度条容器 (延长并添加文件名) -->
                        <StackPanel Width="400" HorizontalAlignment="Center" Orientation="Vertical"
                                    Margin="10,0,0,0">

                            <!-- 文件名显示 -->
                            <TextBlock Text="{Binding SelectedFile.Name}" 
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,5"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding FileName}"
                                MaxWidth="380"/>

                            <!-- 进度条和时间标签 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Slider Grid.Column="1"
                                        x:Name="ProgressSlider"
                                        Minimum="0" 
                                        Maximum="100" 
                                        IsEnabled="{Binding IsPlaying}"
                                        Value="{Binding ProgressValue}"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                        VerticalAlignment="Center"
                                        Width="Auto"
                                        IsMoveToPointEnabled="True"
                                        Thumb.DragStarted="Slider_DragStarted"
                                        Thumb.DragCompleted="Slider_DragCompleted"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- 最右侧：继续按钮 -->
                    <Button Grid.Column="2" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            ToolTip="继续"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding CanPlay}"
                            Click="ContinueButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" 
                                         Width="20" 
                                         Height="20"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                            <TextBlock Text="继 续" 
                           VerticalAlignment="Center"
                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== 第二行：搜索栏 ==================== -->
            <Border Grid.Row="1" 
                Padding="10" 
                Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                BorderThickness="0,0,0,0.5">
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" 
                         Kind="Magnify" 
                         Width="20" 
                         Height="20"
                         VerticalAlignment="Center"
                         Margin="8,0,10,0"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                        <TextBox Grid.Column="1" 
         x:Name="SearchTextBox"
         VerticalAlignment="Center"
         materialDesign:HintAssist.Hint="搜索文件..."
         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
         Foreground="{DynamicResource MaterialDesignBody}"
         TextChanged="SearchTextBox_TextChanged">
                        </TextBox>
                        <materialDesign:PackIcon Grid.Column="2"
                                    Kind="CloseCircle" 
                                    Width="20" 
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Margin="0,8,8,8"
                                    Cursor="Hand"
                                    Foreground="{DynamicResource MaterialDesignBody}"
                                    ToolTip="清除搜索"
                                    MouseLeftButtonDown="ClearSearchTextBox"/>
                    </Grid>
                </Border>
                
            </Border>

            <!-- ==================== 第三行：文件列表滚动视图 ==================== -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="10"
                    x:Name="ScrollViewer">
                    <ListBox x:Name="FileItemsControl"
                        ItemsSource="{Binding FilteredFiles}"
                        SelectionMode="Single"
                        SelectionChanged="FileListBox_SelectionChanged">
                        <!-- 使用 VirtualizingStackPanel 提升大量数据性能 -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                        <!-- 每一条文件记录 -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15,12" 
                                    CornerRadius="6"
                                    Background="{DynamicResource Mat}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 文件名 -->
                                        <StackPanel Grid.Column="0" 
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileMusicOutline" 
                                                     Width="20" 
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="{Binding Name}" 
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <!-- ==================== 第四行：文件计数状态栏 ==================== -->
            <Border Grid.Row="3" 
                Padding="15,10" 
                Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="FileDocumentMultiple" 
                                         Width="18" 
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBlock FontSize="14" 
                           VerticalAlignment="Center">
                    <Run Text="当前显示 " Foreground="{DynamicResource MaterialDesignBody}"/>
                    <Run Text="{Binding FilteredFiles.Count, Mode=OneWay}" 
                         FontWeight="Bold"
                         Foreground="{DynamicResource MaterialDesignBody}"/>
                    <Run Text=" 个文件" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
